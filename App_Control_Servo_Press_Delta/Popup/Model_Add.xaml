<Window x:Class="App_Control_Servo_Press_Delta.Popup.Model_Add"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:App_Control_Servo_Press_Delta.Popup"
    mc:Ignorable="d"
        ResizeMode="NoResize" 
        WindowStyle="None" Height="180" Width="320">
    <Window.Resources>
        <!-- Định nghĩa Style cho Button với Border -->
        <Style TargetType="TextBox" x:Key="StyleTextbox1">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />

        </Style>
    </Window.Resources>
    <Grid>
        <Border BorderBrush="Black" BorderThickness="0.5"/>
        <StackPanel>
            <Grid Height="30" 
                  PreviewMouseDown="Grid_MouseDown">
                <TextBox Text="Tên bảng"
                         x:Name="Name_Table"
                           HorizontalContentAlignment="Center"
                         VerticalContentAlignment="Center"
                         FontSize="15">

                </TextBox>
                <StackPanel Width="15"
                                Height="15"
                                HorizontalAlignment="Right"
                                Margin="0,5,5,0"
                                VerticalAlignment="Top">
                    <Image  Source="..\Images\Exit.png"
                                        HorizontalAlignment="Left"
                                        Stretch="Fill"
                                        PreviewMouseDown="infor_exit">
                    </Image>
                </StackPanel>


            </Grid>
            <Grid Height="105">
                <Grid Margin="5" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Height="45" Grid.Column="0" VerticalAlignment="Top">
                        <Border BorderBrush ="Black" CornerRadius="4" BorderThickness="0.5" Margin="0,7.5,5,2.5" />
                        <ComboBox x:Name="CBB_Model"
                                 Margin="5,10,10,0"
                                 Height="30"
                                 FontSize="15"  
                                 HorizontalAlignment="Stretch"
                                 Background="White"
                                 BorderBrush="White"  VerticalAlignment="Top" />
                    </Grid>
                    <Grid  Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="45"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="45"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="1">
                            <Border BorderBrush ="Black" CornerRadius="4" BorderThickness="0.5" Margin="0,2.5,0,7.5" />
                            <TextBox x:Name="TB_Model"                
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch"
                             Margin="5,0,5,5"
                             Height="30"
                             FontSize="15"               
                             Style="{StaticResource StyleTextbox1}">
                            </TextBox>
                            <Label Content="ID"
                                           FontWeight="Bold"
                                           Background="White"
                                           Width="16"
                                           Height="20"
                                           Padding="1"
                                           HorizontalAlignment="Left"
                                           Margin="10,-45,0,0"
                                           Foreground="Black"/>
                        </Grid>
                        <Grid Grid.Row="3">
                            <Border BorderBrush ="Black" CornerRadius="4" BorderThickness="0.5" Margin="0,0,0,10" />
                            <TextBox x:Name="TB_S_Model"                
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Margin="5,0,5,10"
                              Height="30"
                              FontSize="15"               
                              Style="{StaticResource StyleTextbox1}">
                            </TextBox>
                            <Label Content="Độ dày"
                                           FontWeight="Bold"
                                           Background="White"
                                           Width="42"
                                           Height="20"
                                           Padding="1"
                                           HorizontalAlignment="Left"
                                           Margin="10,-50,0,0"
                                           Foreground="Black"/>
                        </Grid>

                    </Grid>

                </Grid>

            </Grid>
            <Grid Height="40" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Hủy" x:Name="BTN_Cancel_Model"  Background="White" Width="60"  Margin="10,0,0,0"  HorizontalAlignment="Left" Click="Click_bt_Cancel_Model" />
                <Button Grid.Column="1" Content="Xóa" x:Name="BTN_Del_Model"  Background="White" Width="60"    HorizontalAlignment="Center" Click="Click_bt_Del_Model" />
                <Button Grid.Column="2" Content="Lưu" x:Name="BTN_Save_Model"  Background="White" Width="60"  Margin="0,0,10,0"  HorizontalAlignment="Right" Click="Click_bt_Save_Model" />

            </Grid>
        </StackPanel>
    </Grid>
</Window>
