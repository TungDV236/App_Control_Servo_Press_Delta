<Window x:Class="App_Control_Servo_Press_Delta.Create_GPIO"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:App_Control_Servo_Press_Delta"
        mc:Ignorable="d"
        ResizeMode="NoResize" 
        WindowStyle="None" Height="200" Width="300">

    <Grid>
        <Border BorderBrush="Black" BorderThickness="0.5"/>
        <StackPanel>
            <Grid >
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" >
                    <Border BorderBrush ="Black" BorderThickness="0.5" />
                    <Button Grid.Row="0" x:Name="btn_infor" HorizontalAlignment="Right" Width="35" Height="25 " VerticalAlignment="Top" Background="Transparent" BorderBrush="White" BorderThickness="0"
                             Margin="0,2.5,2.5,0" Padding="0" 
                             MouseEnter="exitButton_MouseEnter" 
                             MouseLeave="exitButton_MouseLeave"
                             PreviewMouseDown="MouseDown_Close">
                        <StackPanel  Width="20">
                            <Image  Source="Images\Exit.png"
                                  HorizontalAlignment="Left"
                                  Stretch="Fill">
                            </Image>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="BẢNG CẬP NHẬT IO" FontWeight="Bold" FontSize="15"  HorizontalAlignment="Center" Padding="5" PreviewMouseDown="Grid_mousedown"/>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Địa chỉ:" FontSize="15" Width="130" FontFamily="Source Sans Pro" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="IO_Address" IsReadOnly="true" FontSize="15" Width="155" Height="35" Margin="0,0,0,0" HorizontalAlignment="Left" Style="{StaticResource BorderBlackTextboxStyle}"/>
                </Grid>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Định nghĩa IO cũ:" FontSize="15" Width="130" FontFamily="Source Sans Pro" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="Name_IO_Old" IsReadOnly="true" FontSize="15" Width="155" Height="35" Margin="0,0,0,0" HorizontalAlignment="Left" Style="{StaticResource BorderBlackTextboxStyle}"/>
                </Grid>
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Định nghĩa IO mới:" FontSize="15" Width="135" FontFamily="Source Sans Pro" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="Name_IO_New"  FontSize="15" Width="155" Height="35" Margin="0,0,0,0" HorizontalAlignment="Left" Style="{StaticResource BorderBlackTextboxStyle}"/>
                </Grid>
                <Grid Grid.Row="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Nhập" x:Name="bt_Import" Width="80" Margin="5,0,0,0" HorizontalAlignment="Left" Click="bt_import_Click"/>
                    <Button Grid.Column="1" Content="Xuất" x:Name="bt_Export" Width="80" Margin="5,0,5,0" HorizontalAlignment="Center" Click="bt_export_Click"/>
                    <Button Grid.Column="2" Content="Lưu" x:Name="bt_Update" Width="80" Margin="0,0,5,0" HorizontalAlignment="Right" Click="bt_update_Click"/>
                </Grid>

            </Grid>
        </StackPanel>
    </Grid>
</Window>
