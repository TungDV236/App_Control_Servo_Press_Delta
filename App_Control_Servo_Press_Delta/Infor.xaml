<Window x:Class="App_Control_Servo_Press_Delta.Infor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:App_Control_Servo_Press_Delta"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    AllowsTransparency="True"
    Background="Transparent"
    WindowState="Maximized"
    WindowStyle="None"
    mc:Ignorable="d"  >
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="Gray"
            Opacity="0.5">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseDown">
                    <i:InvokeCommandAction Command="{Binding GridClickCommand}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </Grid>
        <materialDesign:Card
            HorizontalAlignment="Center" Height="400" Width="300"
            materialDesign:ElevationAssist.Elevation="Dp16"
            UniformCornerRadius="5" x:Name="FocusBorder" RenderTransformOrigin="0.5,0.5">
            <materialDesign:Card.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleY="0"/>
                    <RotateTransform/>
                    <TranslateTransform Y="0"/>
                </TransformGroup>
            </materialDesign:Card.RenderTransform>
            <Grid>
                <Border BorderBrush="Black" BorderThickness="0.5"/>
                <StackPanel>
                    <Grid Height="50" 
                  PreviewMouseDown="Grid_MouseDown">
                        <Grid Width="70"
                      HorizontalAlignment="Left">
                            <StackPanel Margin="7">
                                <Image Source="Images\Logo STI.png"
                                             Width="55"
                                             HorizontalAlignment="Left"
                                             Margin="0,0,0,0"
                                             Stretch="Fill">
                                </Image>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="70,5,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <Label Content="Machine Press Bearing" FontSize="12" FontFamily="Source Sans Pro" Foreground="Black" FontWeight="Bold" Width="140" HorizontalAlignment="Left"  />
                                <Label x:Name="lb_Version" FontSize="12" FontFamily="Source Sans Pro" Foreground="Black"  Width="80" HorizontalAlignment="Left" Margin="145,-24,0,0 " VerticalAlignment="Center"/>
                              
                            </StackPanel>
                            <StackPanel Grid.Row="1">
                                <Label Content="Release date for this Verison: 05/03/2025" FontSize="12" FontFamily="Source Sans Pro" Foreground="Black"  HorizontalAlignment="Left"  />
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <Grid Height="100">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="43*"/>
                            <ColumnDefinition Width="277*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Label Grid.Row="1" Content="Copyright(c) 2016 STI-Automation. " FontSize="12" FontFamily="Source Sans Pro" Foreground="Black"  HorizontalAlignment="Left"  Margin="10,0,0,0" Grid.ColumnSpan="2"/>
                        <TextBlock Grid.Row="2" Text=" " 
                           FontSize="12" FontFamily="Source Sans Pro" Grid.ColumnSpan="2" 
                           Foreground="Black"  HorizontalAlignment="Left"  
                           Margin="15,5,0,0" 
                           Cursor="Hand" 
                           MouseDown="Website_MouseDown" >
                    Website:  <Span Foreground="Blue"><Underline>https://stivietnam.com </Underline> </Span>
                        </TextBlock>
                        <Label Grid.Row="4" Content="This product is licensed to:" FontSize="12" FontFamily="Source Sans Pro" Foreground="Black"  HorizontalAlignment="Left"  Margin="10,0,0,0" Grid.ColumnSpan="2"/>
                    </Grid>
                    <Grid Margin="10,0,10,0"
                  Height="210">
                        <Border BorderBrush="Black" BorderThickness="0.5"></Border>
                        <Grid>
                            <Label Content="Name:  Machine Press Bearings UI" FontSize="12" FontFamily="Source Sans Pro" Foreground="Black" Margin="5,5,0,0" Height="20" VerticalAlignment="Top"/>
                            <Label Content="PO" FontSize="12" FontFamily="Source Sans Pro" Foreground="Black" Margin="5,25,0,0" Height="20" VerticalAlignment="Top"/>
                            <Label Content="Create date: 05/03/2025" FontSize="12" FontFamily="Source Sans Pro" Foreground="Black" Margin="5,45,0,0" Height="20" VerticalAlignment="Top"/>
                            <Label Content="Infor Service:" FontSize="12" FontFamily="Source Sans Pro" Foreground="Black" Margin="5,45,0,0" Height="20" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Grid>

                </StackPanel>
            </Grid>

        </materialDesign:Card>
    </Grid>
</Window>

