<Window x:Class="App_Control_Servo_Press_Delta.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:App_Control_Servo_Press_Delta"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    AllowsTransparency="True"
    Background="Transparent"
    WindowState="Maximized"
    WindowStyle="None"
    mc:Ignorable="d"  >
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="Gray"
            Opacity="0.5">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseDown">
                    <i:InvokeCommandAction Command="{Binding GridClickCommand}"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </Grid>
        <materialDesign:Card
            HorizontalAlignment="Center" Height="280" Width="auto"
            materialDesign:ElevationAssist.Elevation="Dp16"
            UniformCornerRadius="5" x:Name="FocusBorder" RenderTransformOrigin="0.5,0.5">
            <materialDesign:Card.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleY="0"/>
                    <RotateTransform/>
                    <TranslateTransform Y="0"/>
                </TransformGroup>
            </materialDesign:Card.RenderTransform>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel  Grid.Column="0">
                    <Image Source="Images/Logo STI.png" Width="250" Height="250" Margin="10,15,0,0" VerticalAlignment="Center" Stretch="Uniform" />
                </StackPanel>
                
                <StackPanel Grid.Column="1" Margin="0,10,-10,10">

                    <Grid Margin="0,0,0,0">

                        <StackPanel >
                            <Label Content="Đăng Nhập" HorizontalAlignment="Center" FontSize="25" FontWeight="Bold" Margin="0,30,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="30,20,30,10">
                                <materialDesign:PackIcon Kind="User" Width="25" Height="25" Foreground="Black"/>
                                <ComboBox  x:Name="txtUsername"  Foreground="Black" Width="220" BorderBrush="Black"   Margin="10,0"  materialDesign:HintAssist.Hint="User name"  >

                                </ComboBox>

                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="30,10,30,0">
                                <materialDesign:PackIcon Kind="Lock" Width="25" Height="25" Foreground="Black"/>
                                <PasswordBox  x:Name="txtPassword" KeyDown="Keydown_Login"  GotFocus="Text_GotFocus" Margin="10 0" materialDesign:HintAssist.Hint="********" Foreground="Black" Width="220" BorderBrush="Black" CaretBrush="#FFD94448" SelectionBrush="#FFD94448" />
                            </StackPanel>
                            <StackPanel Margin="35,30,10,10" HorizontalAlignment="Center">
                                <Button Width="200" x:Name="bt_Login" Height="40" Style="{StaticResource MaterialDesignRaisedButton}" 
                         materialDesign:ButtonAssist.CornerRadius="10" BorderThickness="2" BorderBrush="#4D50B9"
                         Background="#4D50B9" Foreground="White" ToolTip="Đăng Nhập" Click="BtnLogin_Click" Content="Đăng Nhập">
                                </Button>
                            </StackPanel>
                        </StackPanel>




                    </Grid>

                </StackPanel>
            </Grid>

        </materialDesign:Card>
    </Grid>

</Window>
