                                <Button Grid.Column="3" Content="{DynamicResource lb_Save}" x:Name="btn_Save_JigU" Background="White"   Margin="5,0,0,0" Click="btn_Save_JigU_Click"  />

                            </Grid>

                        </Grid>
                    </Grid>

                </Grid>

