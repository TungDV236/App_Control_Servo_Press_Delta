<UserControl x:Class="App_Control_Servo_Press_Delta.Setting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:App_Control_Servo_Press_Delta"
             mc:Ignorable="d" 
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             d:DesignHeight="785" d:DesignWidth="1752">

    <Grid x:Name="Grid_size" >
        <Grid >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="-1,0,0,0" >
                <Border  BorderBrush="#1f1f1f" BorderThickness="1"/>
                <Grid >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Height="30" Grid.Row="0">
                        <Border  BorderBrush="#1f1f1f" BorderThickness="1"/>

                        <Label Content="{DynamicResource lb_Machine_Parameter}"
                                    FontSize="20"
                                    HorizontalAlignment="Center"
                                    FontFamily="Source Sans Pro"
                                    Foreground="Black"
                                    FontStyle="Normal"
                                    FontWeight="Bold"
                                    Margin="2,0,0,0"
                                    VerticalAlignment="Bottom">
                        </Label>
                    </Grid>
                    <Grid Grid.Row="1"   Height="30" Margin="0,5,5,0">
                        <Grid >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label  Grid.Column="0"   Content="{DynamicResource LB_Base_Jig_Thickness}" FontSize="15" HorizontalAlignment="Center" Margin="0,-5,0,0"  FontWeight="Bold" Style="{StaticResource Basic_labelStyle}"  />
                            <Label  Grid.Column="1"   Content="{DynamicResource LB_Ofset_Shaft_Machine}" FontSize="15" HorizontalAlignment="Center" Margin="0,-5,0,0" FontWeight="Bold"  Style="{StaticResource Basic_labelStyle}"  />
                            <Label  Grid.Column="2"   Content="---" FontSize="15" HorizontalAlignment="Center" Margin="0,-5,0,0"   Style="{StaticResource Basic_labelStyle}"  />

                        </Grid>


                    </Grid>
                    <Grid Grid.Row="2"  Margin="5,-5,5,0" Height="50">
                        <Grid >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox  Grid.Column="0"   x:Name="tb_Base_jig_thickness" FontSize="15"  Margin="2"  Style="{StaticResource BorderBlackTextboxStyle}"  />
                            <TextBox  Grid.Column="1"  x:Name="tb_Ofset_Shaft_Machine"  FontSize="15"  Margin="2"  Style="{StaticResource BorderBlackTextboxStyle}"  />
                            <TextBox  Grid.Column="2"    Margin="2"  FontSize="15"  Style="{StaticResource BorderBlackTextboxStyle}"  />

                        </Grid>


                    </Grid>
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="{DynamicResource lb_Cancel}"  x:Name ="BTN_Setting_MCancel"   Margin="5 0 5 0"  Click="Click_Para_Cancel"   Visibility="Visible" />
                        <Button Grid.Column="2" Content="{DynamicResource lb_Edit}" x:Name="btn_Set_ParaEdit" Margin="5,5,5,0" Click="btn_Set_ParaEdit_Click" Height="32" VerticalAlignment="Top" />
                        <Button Grid.Column="3" Content="{DynamicResource lb_Save}" x:Name="btn_Set_ParaSave"  Height="30" Margin="5,5,4,5" Click="btn_Set_ParaSave_Click" />

                    </Grid>

                </Grid>
            </Grid>
            <Grid Grid.Column="1" Margin="-1,0,0,0" >
                <Border  BorderBrush="#1f1f1f" BorderThickness="1"/>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Height="30" Grid.Row="0">
                        <Border  BorderBrush="#1f1f1f" BorderThickness="1"/>

                        <Label Content="{DynamicResource lb_Setting_Master}"
                                    FontSize="20"
                                    HorizontalAlignment="Center"
                                    FontFamily="Source Sans Pro"
                                    Foreground="Black"
                                    FontStyle="Normal"
                                    FontWeight="Bold"
                                    Margin="2,0,0,0"
                                    VerticalAlignment="Bottom">
                        </Label>
                    </Grid>
                    <Grid Grid.Row="1" Margin="10,15,15,15">
                        <Label    Content="{DynamicResource lb_Setting_Master}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Left" Margin="0,-5,0,0"   Style="{StaticResource Basic_labelStyle}"  />
                    </Grid>
                    <Grid Grid.Row="2"  Margin="10,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{DynamicResource lb_JigU}" x:Name="Set_Model_Jig_Up" Height="60" FontSize="15"  Margin=" 5"  />
                        <Button Grid.Column="1" Content="{DynamicResource lb_JigM}" x:Name="Set_Model_Jig_Mid" Height="60"  FontSize="15"   Margin="5"  />
                        <Button Grid.Column="2" Content="{DynamicResource lb_JigD}" x:Name="Set_Model_Jig_Down" Height="60"  FontSize="15"  Margin=" 5"    />
                    </Grid>
                    <Grid Grid.Row="3"  Margin="10,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{DynamicResource lb_Upper_Bearings}" x:Name="Set_Model_Beer_Up" Height="60"  FontSize="15"  Margin="5"   />
                        <Button Grid.Column="1" Content="{DynamicResource lb_Lower_Bearings}" x:Name="Set_Model_Beer_Down" Height="60"  FontSize="15"  Margin="5"   />
                        <Button Grid.Column="2" Content="{DynamicResource lb_History_Error_Config}"  x:Name="Set_History"  Height="60" FontSize="15"   Margin="5"   />
                    </Grid>
                </Grid>
            </Grid>
            <Grid Grid.Column="2" >
                <Border  BorderBrush="#1f1f1f" BorderThickness="1"/>
                <Grid >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Height="30" Grid.Row="0">
                        <Border  BorderBrush="#1f1f1f" BorderThickness="1"/>

                        <Label Content="{DynamicResource lb_Systems}"
                                    FontSize="20"
                                    HorizontalAlignment="Center"
                                    FontFamily="Source Sans Pro"
                                    Foreground="Black"
                                    FontStyle="Normal"
                                    FontWeight="Bold"
                                    Margin="2,0,0,0"
                                    VerticalAlignment="Bottom">
                        </Label>
                    </Grid>
                    <Grid Grid.Row="1"
                            Margin="0,0,5,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="6*"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>
                            <Label  Grid.Column="1"   Content="IP"    Background="White"  FontWeight="Bold"   FontSize="15"   Height="40"   Padding="1" HorizontalContentAlignment="Center"
                            HorizontalAlignment="Stretch"    VerticalAlignment="Top"   Margin="0,5,5,0"    Foreground="Black"/>
                            <Label  Grid.Column="2"   Content="Port"   Background="White"  FontWeight="Bold"   FontSize="15"   Height="40"   Padding="1" HorizontalContentAlignment="Center"
                            HorizontalAlignment="Stretch"    VerticalAlignment="Top"   Margin="0,5,5,0"    Foreground="Black"/>
                        </Grid>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="6*"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>
                            <Label  Grid.Column="0"   Content="Server:"  FontSize="15" FontWeight="Bold" HorizontalAlignment="Left" Margin="10,0,0,0"   Style="{StaticResource Basic_labelStyle}"  />
                            <TextBox  Grid.Column="1"  IsReadOnly="True"  FontSize="15"  x:Name="TB_Server_IP"  Margin="2"  Style="{StaticResource BorderBlackTextboxStyle}"  />
                            <TextBox  Grid.Column="2"  IsReadOnly="True"  FontSize="15"  x:Name="TB_Server_Port"  Margin="2"  Style="{StaticResource BorderBlackTextboxStyle}"  />
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="6*"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>
                            <Label  Grid.Column="0"   Content="PLC:"   FontSize="15" FontWeight="Bold"  HorizontalAlignment="Left" Margin="10,0,0,0"  Style="{StaticResource Basic_labelStyle}"  />
                            <TextBox  Grid.Column="1"  IsReadOnly="True"  FontSize="15"  x:Name="TB_PLC_IP"  Margin="2"  Style="{StaticResource BorderBlackTextboxStyle}"  />
                            <TextBox  Grid.Column="2"  IsReadOnly="True"  FontSize="15"  x:Name="TB_PLC_Port"  Margin="2"  Style="{StaticResource BorderBlackTextboxStyle}"  />
                        </Grid>
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1" Content="{DynamicResource lb_Edit}" x:Name="btn_Set_SysEdit" Margin="5,5,5,0" Click="btn_Set_SysEdit_Click" Height="32" VerticalAlignment="Top" />
                            <Button Grid.Column="2" Content="{DynamicResource lb_Save}" x:Name="btn_Set_SysSave"  Height="30" Margin="5,5,4,5" Click="btn_Set_SysSave_Click" />

                        </Grid>
                        <Grid Grid.Row="6"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

