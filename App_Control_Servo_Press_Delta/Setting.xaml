                                         Width="200" >

                                    </DataGridTextColumn>

                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <Grid    Grid.Row="2">

                            <Border  BorderBrush="#1f1f1f" BorderThickness="0.5"/>
                            <Grid Margin="0,5,0,5">
