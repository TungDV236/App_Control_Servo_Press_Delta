                              Background="White"
                              BorderBrush="Black"
                              BorderThickness="0.5"
                              Margin="2,2,2,4"
                              HorizontalGridLinesBrush="Black"
                              CanUserResizeColumns="False"
                              CanUserResizeRows="False"
                              IsReadOnly="True"
                              Grid.ColumnSpan="2">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="STT"
                                         Foreground="Black"
                                         Binding="{Binding STT}"
                                         Width="80">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="HorizontalAlignment"
                                                 Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="ID"
                                         Binding="{Binding ID_Code}"
                                         Width="120" >

                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Description"
                                         Binding="{Binding Description}"
                                         Width="300" >

                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Solution"
                                         Binding="{Binding Solution}"
                                         Width="300" >

                                    </DataGridTextColumn>

                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <Grid    Grid.Row="2">

                            <Border  BorderBrush="#1f1f1f" BorderThickness="0.5"/>
                            <Grid Margin="0,5,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="5"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="1"  Content="{DynamicResource lb_Import}" x:Name="btn_import_HisE" Background="White" Padding="0"  Margin="0,0,5,0"   Click="Click_bt_Import_HisE"/>
                                <Button Grid.Column="3" Content="{DynamicResource lb_Export}" x:Name="btn_export_HisE" Background="White" Padding="0"  Margin="5,0,0,0"   Click="Click_bt_Export_HisE" />

                            </Grid>
                        </Grid>
                        <Grid Grid.Row="3"  Margin="5,12,5,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <Grid >
                                    <Border BorderBrush ="Black" CornerRadius="4" BorderThickness="0.5" Margin="0,2.5,0,2.5" />
                                    <TextBox  x:Name="tb_code"   FontWeight="Bold"  FontSize="15" Height="40" Margin="5" Style="{StaticResource BorderTransparentTextBoxStyle}"/>
                                </Grid>

                                <Label Content="{DynamicResource lb_Code}"   FontWeight="Bold"    Background="White"   Width="30"  Height="20"   Padding="1" 
      HorizontalAlignment="Left"  VerticalAlignment="Top"   Margin="10,-10,0,0"    Foreground="Black"/>
                            </Grid>
                            <Grid Grid.Column="1" Margin="5,0,0,0">
                                <Grid >
                                    <Border BorderBrush ="Black" CornerRadius="4" BorderThickness="0.5" Margin="0,2.5,0,2.5" />
                                    <TextBox  x:Name="tb_DescriptionEN"   FontWeight="Bold"  FontSize="15" Height="40" Margin="5" Style="{StaticResource BorderTransparentTextBoxStyle}"/>
                                </Grid>

                                <Label Content="{DynamicResource lb_DescriptionEn}"   FontWeight="Bold"    Background="White"   Width="100"  Height="20"   Padding="1" 
                                   HorizontalAlignment="Left"  VerticalAlignment="Top"   Margin="10,-10,0,0"    Foreground="Black"/>
                            </Grid>
                            <Grid Grid.Column="2" Margin="5,0,0,0">
                                <Grid >
                                    <Border BorderBrush ="Black" CornerRadius="4" BorderThickness="0.5" Margin="0,2.5,0,2.5" />
                                    <TextBox  x:Name="tb_SolutionEn"   FontWeight="Bold"  FontSize="15" Height="40" Margin="5" Style="{StaticResource BorderTransparentTextBoxStyle}"/>
                                </Grid>

                                <Label Content="{DynamicResource lb_SolutionEn}"   FontWeight="Bold"    Background="White"   Width="100"  Height="20"   Padding="1" 
                                   HorizontalAlignment="Left"  VerticalAlignment="Top"   Margin="10,-10,0,0"    Foreground="Black"/>
                            </Grid>
                        </Grid>
                        <Grid Grid.Row="4"  Margin="5,12,5,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                          
                            <Grid Grid.Column="1" Margin="5,0,0,0">
                                <Grid >
                                    <Border BorderBrush ="Black" CornerRadius="4" BorderThickness="0.5" Margin="0,2.5,0,2.5" />
                                    <TextBox  x:Name="tb_DescriptionVI"   FontWeight="Bold"  FontSize="15" Height="40" Margin="5" Style="{StaticResource BorderTransparentTextBoxStyle}"/>
                                </Grid>

                                <Label Content="{DynamicResource lb_DescriptionVi}"   FontWeight="Bold"    Background="White"   Width="100"  Height="20"   Padding="1" 
                                   HorizontalAlignment="Left"  VerticalAlignment="Top"   Margin="10,-10,0,0"    Foreground="Black"/>
                            </Grid>
                            <Grid Grid.Column="2" Margin="5,0,0,0">
                                <Grid >
                                    <Border BorderBrush ="Black" CornerRadius="4" BorderThickness="0.5" Margin="0,2.5,0,2.5" />
                                    <TextBox  x:Name="tb_SolutionVi"   FontWeight="Bold"  FontSize="15" Height="40" Margin="5" Style="{StaticResource BorderTransparentTextBoxStyle}"/>
                                </Grid>

                                <Label Content="{DynamicResource lb_SolutionVI}"   FontWeight="Bold"    Background="White"   Width="100"  Height="20"   Padding="1" 
                                   HorizontalAlignment="Left"  VerticalAlignment="Top"   Margin="10,-10,0,0"    Foreground="Black"/>
                            </Grid>
                        </Grid>
                        <Grid Grid.Row="5">
                            <Border BorderBrush="Black" BorderThickness="1"/>
                            <Grid    Margin="0,5,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="5"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="1"  Content="{DynamicResource lb_Delete}" x:Name="BTN_Del_HisE" Background="White"  Margin="0,0,5,0"   Click="Click_bt_Del_HisE"/>
                                <Button Grid.Column="3" Content="{DynamicResource lb_Save}" x:Name="BTN_Save_HisE" Background="White"   Margin="5,0,0,0"   Click="Click_bt_Save_HisE" />

                            </Grid>

                        </Grid>
                    </Grid>

                </Grid>
            </Grid>
            
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" >
                    <Border  BorderBrush="#1f1f1f" BorderThickness="1"/>
                    <Grid >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Height="30" Grid.Row="0">
                            <Border  BorderBrush="#1f1f1f" BorderThickness="1"/>

                            <Label Content="{DynamicResource lb_Systems}"
                                    FontSize="20"
                                    HorizontalAlignment="Center"
                                    FontFamily="Source Sans Pro"
                                    Foreground="Black"
                                    FontStyle="Normal"
                                    FontWeight="Bold"
                                    Margin="2,0,0,0"
                                    VerticalAlignment="Bottom">
                            </Label>
                        </Grid>
                        <Grid Grid.Row="1"
                            Margin="0,0,5,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="6*"/>
                                    <ColumnDefinition Width="3*"/>
                                </Grid.ColumnDefinitions>
                                <Label  Grid.Column="1"   Content="IP"    Background="White"  FontWeight="Bold"   FontSize="15"   Height="40"   Padding="1" HorizontalContentAlignment="Center"
                            HorizontalAlignment="Stretch"    VerticalAlignment="Top"   Margin="0,5,5,0"    Foreground="Black"/>
                                <Label  Grid.Column="2"   Content="Port"   Background="White"  FontWeight="Bold"   FontSize="15"   Height="40"   Padding="1" HorizontalContentAlignment="Center"
                            HorizontalAlignment="Stretch"    VerticalAlignment="Top"   Margin="0,5,5,0"    Foreground="Black"/>
                            </Grid>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="6*"/>
                                    <ColumnDefinition Width="3*"/>
                                </Grid.ColumnDefinitions>
                                <Label  Grid.Column="0"   Content="Server:"  FontSize="15" HorizontalAlignment="Left" Margin="10,0,0,0"   Style="{StaticResource Basic_labelStyle}"  />
                                <TextBox  Grid.Column="1"  IsReadOnly="True"  x:Name="TB_Server_IP"  Margin="2"  Style="{StaticResource BorderBlackTextboxStyle}"  />
                                <TextBox  Grid.Column="2"  IsReadOnly="True"  x:Name="TB_Server_Port"  Margin="2"  Style="{StaticResource BorderBlackTextboxStyle}"  />
                            </Grid>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="6*"/>
                                    <ColumnDefinition Width="3*"/>
                                </Grid.ColumnDefinitions>
                                <Label  Grid.Column="0"   Content="PLC:"   FontSize="15"  HorizontalAlignment="Left" Margin="10,0,0,0"  Style="{StaticResource Basic_labelStyle}"  />
                                <TextBox  Grid.Column="1"  IsReadOnly="True"  x:Name="TB_PLC_IP"  Margin="2"  Style="{StaticResource BorderBlackTextboxStyle}"  />
                                <TextBox  Grid.Column="2"  IsReadOnly="True"  x:Name="TB_PLC_Port"  Margin="2"  Style="{StaticResource BorderBlackTextboxStyle}"  />
                            </Grid>
                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="1" Content="{DynamicResource lb_Edit}" x:Name="BTN_Set_SysEdit"  Height="30" Margin="5,5,5,5"   Click="Click_BTN_Set_SysEdit"/>
                                <Button Grid.Column="2" Content="{DynamicResource lb_Save}" x:Name="BTN_Set_SysSave"  Height="30" Margin="5,5,4,5"   Click="Click_BTN_Set_SysSave" />

                            </Grid>
                            <Grid Grid.Row="6">

                                <Button  Content="{DynamicResource btn_Off_Buzzer}" Width="100" x:Name="btn_off_bz"  Height="40" Margin="5,5,4,5"   Click="Click_off_bz" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

