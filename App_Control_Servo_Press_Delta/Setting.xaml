                                </Grid.ColumnDefinitions>
                                <Label  Grid.Column="0"   Content="Server:"  FontSize="15" HorizontalAlignment="Left" Margin="10,0,0,0"   Style="{StaticResource Basic_labelStyle}"  />
                                <TextBox  Grid.Column="1"  IsReadOnly="True"  x:Name="TB_Server_IP"  Margin="2"  Style="{StaticResource BorderBlackTextboxStyle}"  />
                                <TextBox  Grid.Column="2"  IsReadOnly="True"  x:Name="TB_Server_Port"  Margin="2"  Style="{StaticResource BorderBlackTextboxStyle}"  />
                            </Grid>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="6*"/>
                                    <ColumnDefinition Width="3*"/>
                                </Grid.ColumnDefinitions>
                                <Label  Grid.Column="0"   Content="PLC:"   FontSize="15"  HorizontalAlignment="Left" Margin="10,0,0,0"  Style="{StaticResource Basic_labelStyle}"  />
                                <TextBox  Grid.Column="1"  IsReadOnly="True"  x:Name="TB_PLC_IP"  Margin="2"  Style="{StaticResource BorderBlackTextboxStyle}"  />
                                <TextBox  Grid.Column="2"  IsReadOnly="True"  x:Name="TB_PLC_Port"  Margin="2"  Style="{StaticResource BorderBlackTextboxStyle}"  />
                            </Grid>
                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="1" Content="{DynamicResource lb_Edit}" x:Name="btn_Set_SysEdit" Margin="5,5,5,0" Click="btn_Set_SysEdit_Click" Height="32" VerticalAlignment="Top" />
                                <Button Grid.Column="2" Content="{DynamicResource lb_Save}" x:Name="btn_Set_SysSave"  Height="30" Margin="5,5,4,5" Click="btn_Set_SysSave_Click" />

                            </Grid>
                            <Grid Grid.Row="6">

                                <Button  Content="{DynamicResource btn_Off_Buzzer}" Width="100" x:Name="btn_off_bz"  Height="40" Margin="5,5,4,5" Click="btn_off_bz_Click"  />
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
                <Grid Grid.Column="1" Margin="-1,0,0,0" >
                    <Border  BorderBrush="#1f1f1f" BorderThickness="1"/>
                    <Grid >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Height="30" Grid.Row="0">
                            <Border  BorderBrush="#1f1f1f" BorderThickness="1"/>

                            <Label Content="{DynamicResource lb_Operation_Parameter}"
                                    FontSize="20"
                                    HorizontalAlignment="Center"
                                    FontFamily="Source Sans Pro"
                                    Foreground="Black"
                                    FontStyle="Normal"
                                    FontWeight="Bold"
                                    Margin="2,0,0,0"
                                    VerticalAlignment="Bottom">
                            </Label>
                        </Grid>
                        <Grid Grid.Row="1"   Height="30" Margin="0,5,5,0">
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label  Grid.Column="0"   Content="{DynamicResource LB_Base_Jig_Thickness}" FontSize="15" HorizontalAlignment="Center" Margin="0,-5,0,0"   Style="{StaticResource Basic_labelStyle}"  />
                                <Label  Grid.Column="1"   Content="{DynamicResource LB_Ofset_Shaft_Machine}" FontSize="15" HorizontalAlignment="Center" Margin="0,-5,0,0"   Style="{StaticResource Basic_labelStyle}"  />
                                <Label  Grid.Column="2"   Content="---" FontSize="15" HorizontalAlignment="Center" Margin="0,-5,0,0"   Style="{StaticResource Basic_labelStyle}"  />

                            </Grid>


                        </Grid>
                        <Grid Grid.Row="2"  Margin="5,-5,5,0" Height="50">
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox  Grid.Column="0"  IsReadOnly="True"  x:Name="tb_Base_jig_thickness"  Margin="2"  Style="{StaticResource BorderBlackTextboxStyle}"  />
                                <TextBox  Grid.Column="1"  IsReadOnly="True"  x:Name="tb_Ofset_Shaft_Machine"  Margin="2"  Style="{StaticResource BorderBlackTextboxStyle}"  />
                                <TextBox  Grid.Column="2"  IsReadOnly="True"    Margin="2"  Style="{StaticResource BorderBlackTextboxStyle}"  />
                               
                            </Grid>


                        </Grid>
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="{DynamicResource lb_Cancel}"  x:Name ="BTN_Setting_MCancel"   Margin="5 0 5 0"  Click="Click_Para_Cancel"   Visibility="Visible" />
                            <Button Grid.Column="2" Content="{DynamicResource lb_Edit}" x:Name="btn_Set_ParaEdit" Margin="5,5,5,0" Click="btn_Set_ParaEdit_Click" Height="32" VerticalAlignment="Top" />
                            <Button Grid.Column="3" Content="{DynamicResource lb_Save}" x:Name="btn_Set_ParaSave"  Height="30" Margin="5,5,4,5" Click="btn_Set_ParaSave_Click" />

                        </Grid>

                    </Grid>
                </Grid>
                <Grid Grid.Column="2" >
                    <Border  BorderBrush="#1f1f1f" BorderThickness="1"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

