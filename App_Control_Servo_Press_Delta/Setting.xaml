                                <Button Grid.Column="3" Content="{DynamicResource lb_Save}" x:Name="btn_Save_JigM" Background="White"   Margin="5,0,0,0" Click="btn_Save_JigM_Click"  />

                            </Grid>

                        </Grid>
                    </Grid>

                </Grid>

                <Grid Grid.Column="2" Margin="-1,0,0,0">
