<UserControl x:Class="App_Control_Servo_Press_Delta.Setting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:App_Control_Servo_Press_Delta"
             mc:Ignorable="d" 
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch" d:DesignWidth="830.697" >

    <Grid x:Name="Grid_size" >
        <Grid >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Border  BorderBrush="#1f1f1f" BorderThickness="1"/>
                <Grid >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Height="30" Grid.Row="0">
                        <Border  BorderBrush="#1f1f1f" BorderThickness="1"/>
                        <Label Content="Thông Số"
                                    FontSize="20"
                                    HorizontalAlignment="Center"
                                    FontFamily="Source Sans Pro"
                                    Foreground="Black"
                                    FontStyle="Normal"
                                    FontWeight="Bold"
                                    Margin="2,0,0,0"
                                    VerticalAlignment="Bottom">
                        </Label>
                    </Grid>
                    <Grid Grid.Row="1"
                            Margin="5,0,5,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Label    Content="THÔNG SỐ MÁY"  FontSize="15" Margin="10,2,2,-5"  Style="{StaticResource Basic_labelStyle}" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                        </Grid>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                            </Grid.ColumnDefinitions>
                            <Label  Grid.Column="1" FontSize="15"  Content="Lực ép max (N/m)"   Margin="2,2,2,-5"  Style="{StaticResource Basic_labelStyle}"   />
                            <Label  Grid.Column="2" FontSize="15"  Content="V Man (mm/s)"   Margin="2,2,2,-5" Style="{StaticResource Basic_labelStyle}"  />
                            <Label  Grid.Column="3" FontSize="15"  Content="V Auto (mm/s)"  Margin="2,2,2,-5"  Style="{StaticResource Basic_labelStyle}"  />
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                            </Grid.ColumnDefinitions>

                            <TextBox  Grid.Column="1" IsReadOnly="True"   x:Name="TB_Force_Max"  Margin="2"  Style="{StaticResource BorderBlackTextboxStyle}"  />
                            <TextBox  Grid.Column="2" IsReadOnly="True"   x:Name="TB_Vman"  Margin="2"  Style="{StaticResource BorderBlackTextboxStyle}"  />
                            <TextBox  Grid.Column="3" IsReadOnly="True"   x:Name="TB_VAuto"  Margin="2"  Style="{StaticResource BorderBlackTextboxStyle}"  />
                        </Grid>
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                            </Grid.ColumnDefinitions>
                            <Label  Grid.Column="1" FontSize="15"  Content="Limit Up"   Margin="2,2,2,-5"  Style="{StaticResource Basic_labelStyle}"  />
                            <Label  Grid.Column="2" FontSize="15"  Content="Limit Down"   Margin="2,2,2,-5"  Style="{StaticResource Basic_labelStyle}"  />
                            <Label  Grid.Column="3" FontSize="15"  Content="---"  Margin="2,2,2,-5"  Style="{StaticResource Basic_labelStyle}"  />
                        </Grid>
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                            </Grid.ColumnDefinitions>

                            <TextBox  Grid.Column="1" IsReadOnly="True"   x:Name="TB_Limit_Up"  Margin="2"  Style="{StaticResource BorderBlackTextboxStyle}"  />
                            <TextBox  Grid.Column="2" IsReadOnly="True"   x:Name="TB_Limit_Down"  Margin="2"  Style="{StaticResource BorderBlackTextboxStyle}"  />
                            <TextBox  Grid.Column="3" IsReadOnly="True"   x:Name="TB_Spare"  Margin="2"  Style="{StaticResource BorderBlackTextboxStyle}"  />
                        </Grid>
                        <Grid Grid.Row="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1" Content="Sửa" x:Name="BTN_Set_ParEdit" Height="30" Margin="5,5,5,5"   Click="Click_Para_Edit"/>
                            <Button Grid.Column="2" Content="Lưu" x:Name="BTN_Set_ParSave" Height="30"  Margin="5,5,4,5"   Click="Click_Para_Save" />
                        </Grid>
                        <Grid Grid.Row="8">
                            <Label    Content="THÔNG SỐ ĐẦU VÀO" FontSize="15"  Margin="10,2,2,2"  Style="{StaticResource Basic_labelStyle}" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                        </Grid>
                        <Grid Grid.Row="9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Jig trên" x:Name="Set_Model_Jig_Up" Height="40" FontSize="15"  Margin=" 5"  />
                            <Button Grid.Column="1" Content="Jig giữa" x:Name="Set_Model_Jig_Mid" Height="40"  FontSize="15"   Margin="5"  />
                            <Button Grid.Column="2" Content="Jig dưới" x:Name="Set_Model_Jig_Down" Height="40"  FontSize="15"  Margin=" 5"    />
                        </Grid>
                        <Grid Grid.Row="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Vòng bi trên" x:Name="Set_Model_Beer_Up" Height="40"  FontSize="15"  Margin="5"   />
                            <Button Grid.Column="1" Content="Vòng bi dưới" x:Name="Set_Model_Beer_Down" Height="40"  FontSize="15"  Margin="5"   />
                            <Button Grid.Column="2" Content="Lỗi/ Cảnh báo" x:Name="Set_History"  Height="40" FontSize="15"   Margin="5"   />
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
            <Grid Grid.Column="1" >
                <Border  BorderBrush="#1f1f1f" BorderThickness="1"/>
                <Grid >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Height="30" Grid.Row="0">
                        <Border  BorderBrush="#1f1f1f" BorderThickness="1"/>

                        <Label Content="Hệ Thống"
                                    FontSize="20"
                                    HorizontalAlignment="Center"
                                    FontFamily="Source Sans Pro"
                                    Foreground="Black"
                                    FontStyle="Normal"
                                    FontWeight="Bold"
                                    Margin="2,0,0,0"
                                    VerticalAlignment="Bottom">
                        </Label>
                    </Grid>
                    <Grid Grid.Row="1"
                            Margin="0,0,5,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="6*"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>
                            <Label  Grid.Column="1"   Content="IP"  FontSize="15" Margin="2"  Style="{StaticResource Basic_labelStyle}"  />
                            <Label  Grid.Column="2"   Content="Port" FontSize="15"  Margin="2"  Style="{StaticResource Basic_labelStyle}"  />
                        </Grid>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="6*"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>
                            <Label  Grid.Column="0"   Content="Server:"  FontSize="15" HorizontalAlignment="Left" Margin="10,0,0,0"   Style="{StaticResource Basic_labelStyle}"  />
                            <TextBox  Grid.Column="1"  IsReadOnly="True"  x:Name="TB_Server_IP"  Margin="2"  Style="{StaticResource BorderBlackTextboxStyle}"  />
                            <TextBox  Grid.Column="2"  IsReadOnly="True"  x:Name="TB_Server_Port"  Margin="2"  Style="{StaticResource BorderBlackTextboxStyle}"  />
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="6*"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>
                            <Label  Grid.Column="0"   Content="PLC:"   FontSize="15"  HorizontalAlignment="Left" Margin="10,0,0,0"  Style="{StaticResource Basic_labelStyle}"  />
                            <TextBox  Grid.Column="1"  IsReadOnly="True"  x:Name="TB_PLC_IP"  Margin="2"  Style="{StaticResource BorderBlackTextboxStyle}"  />
                            <TextBox  Grid.Column="2"  IsReadOnly="True"  x:Name="TB_PLC_Port"  Margin="2"  Style="{StaticResource BorderBlackTextboxStyle}"  />
                        </Grid>
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1" Content="Sửa" x:Name="BTN_Set_SysEdit"  Height="30" Margin="5,5,5,5"   Click="Click_BTN_Set_SysEdit"/>
                            <Button Grid.Column="2" Content="Lưu" x:Name="BTN_Set_SysSave"  Height="30" Margin="5,5,4,5"   Click="Click_BTN_Set_SysSave" />

                        </Grid>
                        <Grid Grid.Row="5"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

