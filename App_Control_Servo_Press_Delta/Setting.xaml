                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="5"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="1"  Content="{DynamicResource lb_Import}" x:Name="btn_import_JigU" Background="White" Padding="0"  Margin="0,0,5,0" Click="btn_import_JigU_Click"  />
