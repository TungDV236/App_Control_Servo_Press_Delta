                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="5"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="1"  Content="{DynamicResource lb_Delete}" x:Name="btn_Del_JigD" Background="White"  Margin="0,0,5,0" Click="btn_Del_JigD_Click" />
                                <Button Grid.Column="3" Content="{DynamicResource lb_Save}" x:Name="btn_Save_JigD" Background="White"   Margin="5,0,0,0" Click="btn_Save_JigD_Click"  />

                            </Grid>

                        </Grid>
                    </Grid>

                </Grid>

                <Grid Grid.Column="3" Margin="-1,0,0,0">
                    <Border  BorderBrush="#1f1f1f" BorderThickness="1"/>
                    <Grid >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0"  Content="{DynamicResource lb_History_Error_Config}"
                                 FontSize="20"
                                 HorizontalAlignment="Center"
                                 FontFamily="Source Sans Pro"
                                 Foreground="Black"
                                 FontStyle="Normal"
                                 FontWeight="Bold"
                                 Margin="2,0,0,0"
                                 VerticalAlignment="Bottom">
                        </Label>

                        <Grid  Grid.Row="1" 
                               Margin="2,0,2,0">
                            <DataGrid x:Name="List_History_Error_Config"
                              AutoGenerateColumns="False"
                              FontSize="20"
                              Foreground="Black"
                              Background="White"
                              BorderBrush="Black"
                              BorderThickness="0.5"
                              Margin="2,2,2,4"
                              HorizontalGridLinesBrush="Black"
                              CanUserResizeColumns="False"
                              CanUserResizeRows="False"
                              IsReadOnly="True"
                              Grid.ColumnSpan="2">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{DynamicResource lb_No}"
                                         Foreground="Black"
                                         Binding="{Binding No}"
                                         Width="80">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="HorizontalAlignment"
                                                 Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="{DynamicResource lb_Code}"
                                         Binding="{Binding Code}"
                                         Width="120" >

                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="{DynamicResource lb_Description}"
                                         Binding="{Binding Description}"
                                         Width="300" >

                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="{DynamicResource lb_Solution}"
                                         Binding="{Binding Solution}"
                                         Width="300" >

                                    </DataGridTextColumn>

                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <Grid    Grid.Row="2">

                            <Border  BorderBrush="#1f1f1f" BorderThickness="0.5"/>
                            <Grid Margin="0,5,0,5">
                                <Grid.ColumnDefinitions>
