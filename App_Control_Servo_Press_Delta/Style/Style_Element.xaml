    <Style TargetType="Label" x:Key="Basic_labelStyle">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontWeight" Value="Regular" />
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontFamily" Value="Source Sans Pro" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Label">
                    <Border BorderBrush="{TemplateBinding BorderBrush}"
                               BorderThickness="{TemplateBinding BorderThickness}"
                               Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Stretch"
                                             VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="txb-hint" TargetType="TextBox">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="DemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="Source Sans Pro" />
        <Setter Property="BorderBrush" Value="Gray" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBorderColor}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Grid
                            Width="Auto"
                            Height="18"
                            Margin="10,2,0,5"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Panel.ZIndex="1"
                            Background="{TemplateBinding Background}">
                            <TextBlock
                                Margin="2"
                                FontSize="12"
                                FontWeight="Regular"
                                Foreground="Black"
                                FontFamily="Source Sans Pro"
                                Text="{TemplateBinding Tag}" />
                        </Grid>
                        <Border
                            x:Name="border"
                            Margin="0,10,0,0"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="10,0,15,0" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
