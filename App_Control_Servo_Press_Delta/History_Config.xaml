<Window x:Class="App_Control_Servo_Press_Delta.History_Config"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:App_Control_Servo_Press_Delta"
        mc:Ignorable="d"
        WindowStyle="None"
        d:DesignHeight="585.667">

    <Grid>
        <Border BorderBrush="Black" BorderThickness="1"/>
        <Grid>
            <Grid.RowDefinitions >
                <RowDefinition Height=" auto"/>
                <RowDefinition Height=" *"/>
                <RowDefinition Height=" auto"/>
                <RowDefinition Height=" auto"/>
                <RowDefinition Height=" auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <TextBlock PreviewMouseDown="Grid_MouseDown" HorizontalAlignment="Stretch">
                </TextBlock>
                <Label Content="DANH SÁCH LỖI/ CẢNH BÁO"
                FontSize="20"
                FontStyle="Normal"
                FontWeight="Bold"
                FontFamily="Source Sans Pro"                
                Height="45"
                VerticalContentAlignment="Center"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" PreviewMouseDown="Grid_MouseDown"></Label>
                <Button Grid.Row="0" x:Name="btn_infor" HorizontalAlignment="Right" Width="35" Height="25 " VerticalAlignment="Top" Background="Transparent" BorderBrush="White" BorderThickness="0"
                    Margin="0,0,0,0" Padding="0" 
                    MouseEnter="exitButton_MouseEnter" 
                    MouseLeave="exitButton_MouseLeave"
                    PreviewMouseDown="MouseDown_Close">
                    <StackPanel  Width="20">
                        <Image  Source="Images\Exit.png"
                                 HorizontalAlignment="Left"
                                 Stretch="Fill">
                        </Image>
                    </StackPanel>
                </Button>
            </Grid>
            <Grid Grid.Row="1">
                <DataGrid x:Name="List_History_CG"
                              AutoGenerateColumns="False"
                              FontSize="20"
                              Foreground="Black"
                              BorderBrush="Black"
                              Background="White"
                              BorderThickness="0.5"
                              Margin="2"
                              HorizontalGridLinesBrush="Black"
                              CanUserResizeColumns="False"
                              CanUserResizeRows="False"
                              IsReadOnly="True"
                              Grid.ColumnSpan="2">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="STT" 
                                    Binding="{Binding STT}"
                                    Width="80" >
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Mã Lỗi" 
                                    Binding="{Binding Code}"
                                    Width="120" >
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Nội dung lỗi/cảnh báo"
                                    Binding="{Binding Content_}"
                                    Width="260" >

                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Cách xử lý"
                            Binding="{Binding Solution}"
                            Width="260">

                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content=" Mã Lỗi"  FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                <Label Grid.Column="1" Content=" Nội Dung Lỗi/ Cảnh Báo" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                <Label Grid.Column="2" Content=" Cách Khắc Phục" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
            </Grid>
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="TB_List_Code" IsReadOnly="true" Margin="5" FontSize="15" Height="35" Style="{StaticResource BorderBlackTextboxStyle}"/>
                <TextBox Grid.Column="1" x:Name="TB_List_content_" IsReadOnly="true" Margin="5" FontSize="15" Height="35" Style="{StaticResource BorderBlackTextboxStyle}"/>
                <TextBox Grid.Column="2" x:Name="TB_List_Solution" IsReadOnly="true" Margin="5" FontSize="15" Height="35" Style="{StaticResource BorderBlackTextboxStyle}"/>

            </Grid>
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Nhập" Margin="10,5,0,5" x:Name="bt_Import" Height="40" Width="100"  HorizontalAlignment="Left" Click="bt_Import_Click"/>
                <Button Grid.Column="1" Content="Xuất" Margin="0,5,0,5" x:Name="bt_Export" Height="40" Width="100"  HorizontalAlignment="Center" Click="bt_Export_Click"/>
                <Button Grid.Column="2" Content="Xóa" Margin="0,5,0,5" x:Name="bt_Clear" Height="40" Width="100"  HorizontalAlignment="Center" Click="bt_Clear_Click"/>
                <Button Grid.Column="3" Content="Lưu" Margin="0,5,0,5" x:Name="bt_Save" Height="40" Width="100"  HorizontalAlignment="Center" Click="bt_Save_Click"/>
                <Button Grid.Column="4" Content="Thoát" Margin="0,5,10,5" x:Name="bt_Exit" Height="40" Width="100"  HorizontalAlignment="Right" Click="bt_Exit_Click"/>
            </Grid>



        </Grid>
    </Grid>
</Window>
