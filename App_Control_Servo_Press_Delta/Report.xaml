<UserControl x:Class="App_Control_Servo_Press_Delta.Report"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:App_Control_Servo_Press_Delta"
             mc:Ignorable="d" 
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             d:DesignHeight="785" d:DesignWidth="1752">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="{DynamicResource lb_From}" Height="25" FontSize="15"   Style="{StaticResource Basic_labelStyle}" Margin="15,5,0,0" />
            <Grid Grid.Column="1" Margin="5">
                <Grid>
                    <Border BorderBrush ="Black" CornerRadius="4" BorderThickness="0.5" Margin="0,2.5,0,-5" Height="50"/>
                    <TextBox  x:Name="Select_date_start" FontWeight="DemiBold" FontSize="15" Height="40"  Width="200" HorizontalAlignment="Left" HorizontalContentAlignment="Center" Margin="5,12,5,5" Style="{StaticResource BorderTransparentTextBoxStyle}"/>
                    <DatePicker Grid.Column="0" Name="datePicker_start"  Visibility="Visible"  Width="30" Height="35" BorderThickness="0.5" HorizontalAlignment="Right" BorderBrush="Transparent"
                    SelectedDateChanged="DatePicker_SelectedDateChanged_start" Margin="10,15,10,10" MouseEnter="Move_datetime_start"   Style="{x:Null}" TextBlock.TextAlignment="Center" TextBlock.FontSize="15" TextBlock.FontWeight="Bold"   Calendar.SelectedDatesChanged="calendar_SelectedDateChanged_start">
                        <DatePicker.CalendarStyle>
                            <Style TargetType="Calendar" BasedOn="{StaticResource MaterialDesignCalendarPortraitForeground}">
                                <!-- Bạn có thể tùy chỉnh thêm các thuộc tính của Calendar ở đây nếu cần -->
                            </Style>
                        </DatePicker.CalendarStyle>
                    </DatePicker>
                </Grid>

            </Grid>
            <Grid Grid.Column="2">
                <Border BorderBrush ="Black" CornerRadius="4" BorderThickness="0.5" Margin="0,2.5,0,-5" Height="50" />
                <Grid Margin="5,0,5,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" x:Name="Hour_start" Height="40" Margin="0,5,0,0" HorizontalContentAlignment="Center" FontSize="15" FontWeight="DemiBold" BorderBrush="Transparent"/>
                    <Label Grid.Column="1" Content=":" FontSize="15"  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="2" x:Name="Minute_start" Height="40" Margin="0,5,0,0" HorizontalContentAlignment="Center" FontSize="15" FontWeight="DemiBold" BorderBrush="Transparent"/>
                    <Label Grid.Column="3" Content=":" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="4" x:Name="Second_start" Height="40" Margin="0,5,0,0" HorizontalContentAlignment="Center" FontSize="15" FontWeight="DemiBold" BorderBrush="Transparent"/>
                </Grid>




            </Grid>
            <Label Grid.Column="3" Content="{DynamicResource lb_to}" Height="25" FontSize="15" Style="{StaticResource Basic_labelStyle}" Margin="15,5,0,0" />
            <Grid Grid.Column="4" Margin="5">
                <Grid>
                    <Border BorderBrush ="Black" CornerRadius="4" BorderThickness="0.5" Margin="0,2.5,0,-5" Height="50"/>
                    <TextBox  x:Name="Select_date_stop" FontWeight="DemiBold" FontSize="15" Height="40"  Width="200" HorizontalAlignment="Left" HorizontalContentAlignment="Center" Margin="5,12,5,5" Style="{StaticResource BorderTransparentTextBoxStyle}"/>
                    <DatePicker Grid.Column="0" Name="datePicker_stop" Visibility="Visible"  Width="30" Height="35" BorderThickness="0.5" HorizontalAlignment="Right" BorderBrush="Transparent"
                    SelectedDateChanged="DatePicker_SelectedDateChanged_stop" Margin="10,15,10,10" MouseEnter="Move_datetime_stop"   Style="{x:Null}" TextBlock.TextAlignment="Center" TextBlock.FontSize="15" TextBlock.FontWeight="Bold"  Calendar.SelectedDatesChanged="calendar_SelectedDateChanged_stop">
                        <DatePicker.CalendarStyle>
                            <Style TargetType="Calendar" BasedOn="{StaticResource MaterialDesignCalendarPortraitForeground}">
                            </Style>
                        </DatePicker.CalendarStyle>
                    </DatePicker>
                </Grid>

            </Grid>
            <Grid Grid.Column="5" Margin="5,0,5,0">
                <Border BorderBrush ="Black" CornerRadius="4" BorderThickness="0.5" Margin="0,2.5,0,-5" Height="50" />
                <Grid Margin="5,0,5,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" x:Name="Hour_Stop" Height="40" Margin="0,5,0,0" HorizontalContentAlignment="Center" FontSize="15"  FontWeight="DemiBold" BorderBrush="Transparent"/>
                    <Label Grid.Column="1" Content=":" FontSize="15"  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="2" x:Name="Minute_Stop" Height="40" Margin="0,5,0,0" HorizontalContentAlignment="Center" FontSize="15"  FontWeight="DemiBold" BorderBrush="Transparent"/>
                    <Label Grid.Column="3" Content=":" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="4" x:Name="Second_Stop" Height="40" Margin="0,5,0,0" HorizontalContentAlignment="Center" FontSize="15"  FontWeight="DemiBold" BorderBrush="Transparent"/>
                </Grid>





            </Grid>
            <Grid Grid.Column="7"  Margin="5,12,5,0">
                <Grid>
                    <Border BorderBrush ="Black" CornerRadius="4" BorderThickness="0.5" Margin="0,2.5,0,2.5" />
                    <TextBox  x:Name="tb_Model_search"   FontWeight="DemiBold"  FontSize="15" Height="40" Margin="5" Style="{StaticResource BorderTransparentTextBoxStyle}"/>
                </Grid>

                <TextBlock Text="{DynamicResource lb_Shaft}"   FontWeight="Bold"    Background="White"   Height="20"   Padding="1" 
        HorizontalAlignment="Left"  VerticalAlignment="Top"   Margin="10,-10,0,0"    Foreground="Black"/>
            </Grid>
            <Button Grid.Column="8" Content="{DynamicResource btn_Search}" Width="120" x:Name="btn_off_bz" Padding="0"  Height="40" Margin="5,15,5,5"   Click="Click_search" />
        </Grid>
        <Grid  Grid.Row="1" Margin="2" >
            <DataGrid x:Name="List_Report"
                              AutoGenerateColumns="False"
                            FontSize="20"
                            Foreground="Black"
                            Background="White"
                            BorderBrush="Black"
                            BorderThickness="0.5"
                            Margin="2,2,2,4"
                            HorizontalGridLinesBrush="Black"
                            CanUserResizeColumns="False"
                            CanUserResizeRows="False"
                            IsReadOnly="True"
                            Grid.ColumnSpan="2"
                      SelectionChanged="Report_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="STT"
                                                Foreground="Black"
                                                Binding="{Binding STT}"
                                                Width="Auto">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment"
                                                Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Time"
                                                Binding="{Binding Time}"
                                                Width="Auto" >
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="OrderCode"
                                                Binding="{Binding OrderCode}"
                                                Width="Auto" >

                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Model"
                                                Binding="{Binding Model}"
                                                Width="Auto" >

                    </DataGridTextColumn>
                    <DataGridTextColumn Header="ID_Shaft"
                                                Binding="{Binding ID_Shaft}"
                                                Width="Auto" >
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="ID_Rotor"
                                                Binding="{Binding ID_Rotor}"
                                                Width="Auto" >
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Force Max"
                                                Binding="{Binding Force_Max}"
                                                Width="Auto" >
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Result"
                                                Binding="{Binding Status}"
                                                Width="Auto" >
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

        </Grid>
        <Button Grid.Row="2" Content="{DynamicResource lb_Auto_Chart}" x:Name="btn_chart" Background="White"  Width="150"  Margin="5,10,170,10" HorizontalAlignment="Right"  Click="Click_bt_chart" />
        <Button Grid.Row="2" Content="{DynamicResource lb_Export}" x:Name="btn_export" Background="White"  Width="150"  Margin="5,10,10,10" HorizontalAlignment="Right"  Click="Click_bt_Export" />
    </Grid>
</UserControl>
