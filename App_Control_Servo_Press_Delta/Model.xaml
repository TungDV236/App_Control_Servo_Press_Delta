                                        <Border BorderBrush ="Black" CornerRadius="4" BorderThickness="0.5" Margin="0,2.5,0,2.5" />
                                        <TextBox  x:Name="tb_num_Distance_Bearings_After"   FontWeight="Bold"  FontSize="15" Height="40" Margin="5" Style="{StaticResource BorderTransparentTextBoxStyle}"/>
                                    </Grid>

                                    <Label Content="{DynamicResource lb_Distance_Bearings_After}"   FontWeight="Bold"    Background="White"   Width="200"  Height="20"   Padding="1" 
