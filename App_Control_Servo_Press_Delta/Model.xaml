HorizontalAlignment="Left"  VerticalAlignment="Top"   Margin="10,-10,0,0"    Foreground="Black"/>
                                </Grid>
                                <Grid Grid.Column="1" Margin="5,0,0,0">
                                    <Grid>
                                        <Border BorderBrush ="Black" CornerRadius="4" BorderThickness="0.5" Margin="5,2.5,0,2.5" />
