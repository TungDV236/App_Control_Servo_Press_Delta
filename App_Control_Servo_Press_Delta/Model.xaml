                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>

                                        <DataGrid x:Name="List_Pressing_condition" Grid.Row="0"
                                                  AutoGenerateColumns="False"
                                                  FontSize="20"
                                                      Height="210"
                                                  Foreground="Black"
                                                  Background="White"
                                                  BorderBrush="Black"
                                                  BorderThickness="0.5"
                                                  Margin="10"
                                                  HorizontalGridLinesBrush="Black"
                                                  CanUserResizeColumns="False"
                                                  CanUserResizeRows="False"
                                                  IsReadOnly="True"
                                                  Grid.ColumnSpan="2">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="{DynamicResource lb_No}"
                                                                    Foreground="Black"
                                                                    Binding="{Binding No}"
                                                                    Width="80">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="{x:Type TextBlock}">
                                                            <Setter Property="HorizontalAlignment"
                                                                    Value="Center" />
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header= "{DynamicResource lb_Auto_Pressing Condition}"
                                                                     Binding="{Binding PressingCondition}"
                                                                     Width="250" >

                                                </DataGridTextColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <Label Grid.Row="1"   Content="{DynamicResource lb_Auto_Step}"  Width="70"  Height="30" HorizontalAlignment="Left" Style="{StaticResource Basic_labelStyle}" Margin="10,5,0,0" />
                                        <Grid Grid.Row="1"   Height="35" Margin="60,5,0,0" Width="65" HorizontalAlignment="Left">
                                            <Border BorderBrush ="Black" BorderThickness="1" Margin="5,2.5,5,2.5" />
                                            <ComboBox x:Name="cbb_step"
                                            FontWeight="Bold"
                                            FontSize="15"  
                                             Margin="10,5,10,5"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Background="White"
                                            BorderBrush="White"  VerticalAlignment="Top" >

                                                <ComboBoxItem Content="1"/>
                                                <ComboBoxItem Content="2"/>
                                            </ComboBox>
                                        </Grid>
                                        <Grid Grid.Row="1"   Height="35"
                                            Margin="130,5,10,0">
                                            <Border BorderBrush ="Black" BorderThickness="1" Margin="5,2.5,5,2.5" />
                                            <ComboBox x:Name="cbb_Pressing_condition"
                                            FontWeight="Bold"
                                            FontSize="15"  
                                             Margin="10,5,10,5"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Background="White"
                                            BorderBrush="White"  VerticalAlignment="Top" >

                                                <ComboBoxItem Content="Position"/>
                                                <ComboBoxItem Content="Force"/>
                                                <ComboBoxItem Content="Distance"/>
                                                <ComboBoxItem Content="Force Position"/>
                                                <ComboBoxItem Content="Force Distance"/>
                                            </ComboBox>
                                        </Grid>
                                        <Grid Grid.Row="2">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Row="0" Grid.Column="0"   Content="{DynamicResource lb_Press_PositionDistance}" Height="35" Style="{StaticResource Basic_labelStyle}" Margin="10,5,0,0" />
                                            <TextBox Grid.Row="0" Grid.Column="1"  x:Name="tb_num_Press_PositionDistance"  Margin="5" FontWeight="Bold" FontSize="15" Height="30" Style="{StaticResource BorderBlackIsReadOnlyTextboxStyle}"/>
                                            <Label Grid.Row="0" Grid.Column="2"   Content="(mm)" Height="35" Style="{StaticResource Basic_labelStyle}" Margin="0,5,0,0" />
                                            <Label Grid.Row="1" Grid.Column="0"   Content="{DynamicResource lb_Press_Force}" Height="30" Style="{StaticResource Basic_labelStyle}" Margin="10,5,0,5" />
                                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="tb_num_Press_Force"  Margin="5" FontWeight="Bold" FontSize="15" Height="30" Style="{StaticResource BorderBlackIsReadOnlyTextboxStyle}"/>
                                            <Label Grid.Row="1" Grid.Column="2"   Content="(N)" Height="30" Style="{StaticResource Basic_labelStyle}" Margin="0,5,0,0" />
                                            <Label Grid.Row="2" Grid.Column="0"   Content="{DynamicResource lb_Press_Velocity}" Height="30" Style="{StaticResource Basic_labelStyle}" Margin="10,5,0,5" />
                                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="tb_num_Press_Velocity"  Margin="5" FontWeight="Bold" FontSize="15" Height="30" Style="{StaticResource BorderBlackIsReadOnlyTextboxStyle}"/>
                                            <Label Grid.Row="2" Grid.Column="2"   Content="(mm/s)" Height="30" Style="{StaticResource Basic_labelStyle}" Margin="0,5,0,0" />
                                            <Label Grid.Row="3" Grid.Column="0"   Content="{DynamicResource lb_Press_Time}" Height="30" Style="{StaticResource Basic_labelStyle}" Margin="10,5,0,5" />
                                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="tb_num_Press_Time"  Margin="5" FontWeight="Bold" FontSize="15" Height="30" Style="{StaticResource BorderBlackIsReadOnlyTextboxStyle}"/>
                                            <Label Grid.Row="3" Grid.Column="2"   Content="(s)" Height="30" Style="{StaticResource Basic_labelStyle}" Margin="0,5,0,0" />
                                        </Grid>
                                    </Grid>
                                </Grid>
                                <Grid Grid.Row="2">

                                    <Grid    Margin="0,10,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="15"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="15"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="3"  Content="{DynamicResource lb_Delete}" x:Name="BTN_Del_Para" Background="White"  Margin="0,0,5,0"   Click="Click_bt_del_Condition"/>
                                      

                                    </Grid>

                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>


                </Grid>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2.5*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Border BorderBrush="Black" BorderThickness="1"/>
                    <Grid    Margin="0,5,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="15"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="1"  Content="{DynamicResource lb_Import}" x:Name="BTN_Import_model" Background="White"  Margin="0,0,5,0"   Click="Click_bt_Import_model"/>
                        <Button Grid.Column="3" Content="{DynamicResource lb_Export}" x:Name="BTN_Export_model" Background="White"   Margin="5,0,0,0"   Click="Click_bt_Export_model" />

                    </Grid>

                </Grid>
                <Grid Grid.Column="1">
                    <Border BorderBrush="Black" BorderThickness="1"/>
                    <Grid    Margin="0,5,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="15"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="1"  Content="{DynamicResource lb_Delete}" x:Name="BTN_Del_Model" Background="White"  Margin="0,0,5,0"   Click="Click_bt_Del_Model"/>
                        <Button Grid.Column="3" Content="{DynamicResource lb_Save}" x:Name="BTN_Save_Model" Background="White"   Margin="5,0,0,0"   Click="Click_bt_Save_model" />

                    </Grid>

                </Grid>
            </Grid>
        </Grid>
    </Grid>

</UserControl>
