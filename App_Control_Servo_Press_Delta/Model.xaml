                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="HorizontalAlignment"
                                                 Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Model"
                                         Binding="{Binding Model}"
                                         Width="120" >

                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Rotor"
                                         Binding="{Binding RotorID}"
                                         Width="110" >

                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="TrụcID"
                                         Binding="{Binding TrucID}"
                                         Width="110" >

                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                       
