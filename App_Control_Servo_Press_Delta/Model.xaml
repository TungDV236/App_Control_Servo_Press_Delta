                            <Label Content="{DynamicResource lb_Operation_Parameter}"  FontSize="20"  HorizontalAlignment="Center"   FontFamily="Source Sans Pro"   Foreground="Black"    FontStyle="Normal"
  FontWeight="Bold"  Margin="2,0,0,0"  VerticalAlignment="Bottom">
