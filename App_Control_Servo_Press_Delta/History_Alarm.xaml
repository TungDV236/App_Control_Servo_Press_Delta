<UserControl x:Class="App_Control_Servo_Press_Delta.History_Alarm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:App_Control_Servo_Press_Delta"
             mc:Ignorable="d" 
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch" >
    <Grid x:Name="Grid_size">
        <Border BorderBrush ="Black" BorderThickness="1" Margin="-1,0,-1,0"/>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Label Content="LỊCH SỬ CẢNH BÁO"
                FontSize="20"
                FontStyle="Normal"
                FontWeight="Bold"
                FontFamily="Source Sans Pro"
                Height="50"
                VerticalContentAlignment="Center"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"></Label>
            </Grid>

            <Grid Grid.Row="1" x:Name="Grid_His">
                <DataGrid x:Name="List_Alarm"
                              AutoGenerateColumns="False"
                              FontSize="20"
                              Foreground="Black"
                              Background="White"
                              BorderBrush="Black"
                              BorderThickness="0.5"
                              Margin="2,2,2,4"
                              HorizontalGridLinesBrush="Black"
                              CanUserResizeColumns="False"
                              CanUserResizeRows="False"
                              IsReadOnly="True"
                              Grid.ColumnSpan="2">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="STT" 
                                  Binding="{Binding STT}"
                                  Width="80" >
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="code" 
                                  Binding="{Binding Code}"
                                  Width="80" >
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Nội dung lỗi"
                                  Binding="{Binding Content_}"
                                  Width="300" >

                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Cách xử lý"
                          Binding="{Binding Solution}"
                          Width="300">

                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Thời Gian"
                          Binding="{Binding Time}"
                         
                          Width="200" >

                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>



        </Grid>

    </Grid>
</UserControl>
