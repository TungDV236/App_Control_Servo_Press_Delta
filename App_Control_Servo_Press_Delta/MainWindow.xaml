<Window x:Class="App_Control_Servo_Press_Delta.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:App_Control_Servo_Press_Delta"
        mc:Ignorable="d"
        WindowStyle="None"
        SizeChanged="Window_SizeChanged" Height="1000" Width="1920">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="250*"/>
            <RowDefinition Height="381*"/>
        </Grid.RowDefinitions>
        <Grid Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <TextBlock PreviewMouseDown="Grid_MouseDown" HorizontalAlignment="Stretch">


                </TextBlock>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="250"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Height="80">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" HorizontalAlignment="Left" Orientation="Horizontal">
                                <Image Source="Images\language 2.png"
                     Width="25"
            Height="25"
                     HorizontalAlignment="Left"
                     Margin="5,0,0,0"
                     Stretch="Fill">
                                </Image>
                                <ComboBox x:Name="LanguageComboBox" Width="120" Height="30" Margin="10"  FontFamily="Source Sans Pro" FontSize="15" Background="White"  BorderThickness="0" BorderBrush="White" Foreground="Black" FontWeight="Bold" 
                                            SelectionChanged="LanguageComboBox_SelectionChanged">
                                    <ComboBoxItem Content="English"/>
                                    <ComboBoxItem Content="Vietnamese" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="1" HorizontalAlignment="Left" Orientation="Horizontal">
                                <Image Source="Images\Infor_User.png"
                                            Width="25"
                                   Height="25"
                                            HorizontalAlignment="Left"
                                            Margin="5,0,0,0"
                                            Stretch="Fill">
                                </Image>
                                <Label  Content="{DynamicResource lb_User}"
                                            Name="L_Select_Model"
                                            FontSize="15"
                                            FontWeight="Bold"
                                            HorizontalContentAlignment="Left"
                                            VerticalContentAlignment="Center" 
                                        FontFamily="Source Sans Pro"
                                            BorderThickness="1"
                                            Width="105"
                                            Margin="5,0,0,0">
                                </Label>
                                <Label Content="-------"
                                            Name="lb_Name"
                                            Foreground="Black"
                                            FontSize="12"
                                       VerticalAlignment="Center"
                                            HorizontalAlignment="Stretch"
                                            FontStyle="Normal"
                                            FontWeight="Bold"
                                            Margin="2,0,0,0"
                                            FontFamily="Source Sans Pro">
                                </Label>
                            </StackPanel>

                        </Grid>

                        <Grid Grid.Column="1">
                            <Label  Content="{DynamicResource lb_Machine_Press_Bearings}" 
                                      x:Name="lb_Name_Machine"
                                      Foreground="Black"
                                      FontSize="30"
                                      FontWeight="Bold"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      FontFamily="Source Sans Pro"
                                     PreviewMouseDown="Grid_MouseDown">
                            </Label>
                        </Grid>
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>


                            <Grid Grid.Row="0" >
                                <Grid  HorizontalAlignment="Right" Margin="0,0,5,0">
                                    <Button  Width="115"  Padding="0"    Name="btn_infor"  Background="Transparent"   BorderBrush="Transparent"
                                           PreviewMouseDown="MouseDown_infor" 
                                           MouseEnter="Infor_MouseEnter" 
                                           MouseLeave="Infor_MouseLeave">
                                        <StackPanel Orientation="Horizontal" Width="200">
                                            <Image Source="Images\info.png"    Width="32"   HorizontalAlignment="Left"    Margin="0,0,0,0"     Stretch="Fill" ></Image>
                                            <Label Content="{DynamicResource lb_Infor}"   FontSize="15"   FontFamily="Source Sans Pro"  FontWeight="Bold"     VerticalContentAlignment="Bottom"
                                                  HorizontalContentAlignment="Left"      BorderThickness="1"   Width="85"   VerticalAlignment="Center"></Label>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>
                            <Grid Grid.Row="1" >
                                <Grid>
                                    <Label   Content="CPU:"
                                             Margin="130,0,0,0"
                                            FontSize="15"
                                           FontFamily="Source Sans Pro"
                                            FontWeight="Bold"
                                            HorizontalContentAlignment="Left"
                                            VerticalContentAlignment="Center"/>
                                    <Label x:Name="Per_CPU"
                                        Margin="180,0,10,0"
                                           Height="25"
                                           HorizontalContentAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontFamily="Source Sans Pro"
                                        FontSize="15"
                                        FontStyle="Normal" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0"  Margin="2">
                    <Border BorderBrush="Black" BorderThickness="2"
                                CornerRadius="4"/>
                    <Grid Width="160">
                        <Grid  Margin="5,5,5,0" VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="5"/>
                            </Grid.RowDefinitions>
                            <Button Grid.Row="0"  x:Name="BTN_Auto"     Content="{DynamicResource btn_Auto}"   FontSize="15" Foreground="Black" Height="70" FontWeight="Bold" FontFamily="Source Sans Pro"  Margin ="3,3,3,3" Click="Click_BTN_Auto" Grid.ColumnSpan="2"/>
                            <Button Grid.Row="1" Content="{DynamicResource btn_Man}" x:Name="BTN_Manual"     FontSize="15" Foreground="Black"  Height="70" FontWeight="Bold" FontFamily="Source Sans Pro"  Margin ="3,3,3,3" Click="Click_BTN_Manual" Grid.ColumnSpan="2"/>
                            <Button Grid.Row="2" Content="{DynamicResource btn_History}" x:Name="BTN_History"     FontSize="15" Foreground="Black"  Height="70" FontWeight="Bold" FontFamily="Source Sans Pro"  Margin ="3,3,3,3" Click="Click_BTN_History" Grid.ColumnSpan="2"/>
                            <Button Grid.Row="3" Content="{DynamicResource btn_Report}" x:Name="BTN_Report"     FontSize="15" Foreground="Black"   Height="70" FontWeight="Bold" FontFamily="Source Sans Pro"   Margin ="3,3,3,0" Click="Click_BTN_Report" Grid.ColumnSpan="2" />
                            <Button Grid.Row="4" Content="{DynamicResource btn_GPIO}" x:Name="BTN_GPIO"  FontSize="15" Foreground="Black"  Height="70" FontWeight="Bold" FontFamily="Source Sans Pro"  Margin ="3,3,3,3"  Click="Click_BTN_GPIO1" Grid.ColumnSpan="2"/>
                            <Button Grid.Row="5" Content="{DynamicResource btn_Model}" x:Name="BTN_Model"         FontSize="15" Foreground="Black"  Height="70" FontWeight="Bold" FontFamily="Source Sans Pro"  Margin ="3,3,3,3"   Click="Click_BTN_Model" Grid.ColumnSpan="2"/>
                            <Button Grid.Row="6" Content="{DynamicResource btn_Setting}" x:Name="BTN_Setting"     FontSize="15" Foreground="Black"  Height="70" FontWeight="Bold" FontFamily="Source Sans Pro"  Margin ="3,3,3,3"   Click="Click_BTN_Setting" Grid.ColumnSpan="2"/>
                            <Grid Grid.Row="8" >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="{DynamicResource btn_login}" x:Name="BTN_Login"  Padding="5,5" Height="35" Margin="2.5,0,2.5,0" FontSize="10"  VerticalAlignment="Top"  Click="bt_Login_Click"/>
                                <Button Grid.Column="1" Content="{DynamicResource btn_logout}"  x:Name="BTN_Logout"  Padding="5,5" Height="35"  Margin="2.5,0,2.5,0"  FontSize="10"  VerticalAlignment="Top" Click="bt_Logout_Click" />
                            </Grid>
                            <Grid Grid.Row="9" >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label  Grid.Column="0" Content="dd/mm/yyyy"  x:Name="lb_day" Foreground="Black" FontSize="10" Margin="0,5,0,0" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontStyle="Normal" FontWeight="Bold" FontFamily="Source Sans Pro" Height="21"/>
                                <Label  Grid.Column="1" Content="hh/mm/ss"   x:Name="lb_time" Foreground="Black" FontSize="10" Margin="0,5,0,0" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontStyle="Normal" FontWeight="Bold" FontFamily="Source Sans Pro"/>
                            </Grid>

                            <Label Grid.Row="10" x:Name="lb_Version"  Content="Ver 1.0.1"
                                             FontFamily="Arial"
                                             FontWeight="Bold"
                                             VerticalContentAlignment="Bottom"
                                             HorizontalContentAlignment="Center"
                                             BorderThickness="1"
                                             Width="85"
                                             VerticalAlignment="Center">
                            </Label>
                            <Button Grid.Row="11" x:Name="BTN_Exit"  Content="{DynamicResource btn_Close}" HorizontalAlignment="Stretch"  Height="35 " VerticalAlignment="Top"  BorderThickness="0"
         Margin="3" Padding="0" 
         PreviewMouseDown="MouseDown_Close">
                            </Button>
                        </Grid>
                    </Grid>


                </Grid>
                <Grid Grid.Column="1" Margin="2">
                    <Border BorderBrush="Black" BorderThickness="2"
                                CornerRadius="4"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width=" Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width=" Auto"/>
                                <ColumnDefinition Width=" Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Image  Source="Images\Chat 4.png"
                                         Width="30"
                                         HorizontalAlignment="Left"
                                         Margin="5"
                                         Stretch="Fill">
                                </Image>

                            </StackPanel>
                            <Grid   Grid.Column="1">
                                <TextBox IsReadOnly="true" x:Name="TB_Notification"  HorizontalAlignment="Stretch" VerticalAlignment ="Center"  FontSize="15" Height="30"  Style="{StaticResource BorderBlackTextboxStyle}"/>
                            </Grid>
                            <Grid Grid.Column="2">
                                <Label Content="PLC"  
                                        x:Name="lb_Connect"
                                            Foreground="Black"
                                            FontSize="20"
                                            Width="80"
                                            Height="30"
                                            HorizontalAlignment="Right"
                                            HorizontalContentAlignment="Center"
                                            FontStyle="Normal"
                                            FontWeight="Bold"
                                            FontFamily="Source Sans Pro">

                                </Label>
                            </Grid>
                            <Grid Grid.Column="3">
                                <Label Content="SERVER"  
                                        x:Name="lb_server_Connect"
                                            Foreground="Black"
                                            FontSize="20"
                                            Width="80"
                                            Height="30"
                                            HorizontalAlignment="Right" Margin="0,0,10,0"
                                            HorizontalContentAlignment="Center"
                                            FontStyle="Normal"
                                            FontWeight="Bold"
                                            FontFamily="Source Sans Pro">

                                </Label>
                            </Grid>

                        </Grid>
                        <Grid Grid.Row="1">
                            <StackPanel>
                                <Grid  >
                                    <Border  BorderBrush="#1f1f1f" BorderThickness="1"/>
                                    <Grid   HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Vertical">
                                            <Label  Content="{DynamicResource lb_Position}"
                                                  Name="lb_VTX"
                                                  Foreground="Black"
                                                  FontSize="15"
                                                    FontWeight="Bold"
                                                  HorizontalAlignment="Center"
                                                  HorizontalContentAlignment="Center"
                                                  Margin="0,5,0,-5"
                                                  FontFamily="Source Sans Pro">
                                            </Label>
                                            <TextBox IsReadOnly="true" x:Name="tb_Position"  Margin="5" FontWeight="DemiBold" FontSize="15" Height="35" Style="{StaticResource BorderBlackTextboxStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Vertical">
                                            <Label  Content="{DynamicResource lb_Force}"
                                                  Name="lb_VTY"
                                                  Foreground="Black"
                                                  FontSize="15"
                                                    FontWeight="Bold"
                                                  HorizontalAlignment="Center"
                                                  Margin="0,5,0,-5"
                                                  HorizontalContentAlignment="Center"
                                                  FontFamily="Source Sans Pro">
                                            </Label>
                                            <TextBox IsReadOnly="true"  x:Name="tb_Force"   Margin="5" FontWeight="DemiBold" FontSize="15" Height="35" Style="{StaticResource BorderBlackTextboxStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Vertical">
                                            <Label  Content="---"
                                                  Name="lb_VTZ"
                                                  Foreground="Black"
                                                  FontSize="15"
                                                    FontWeight="Bold"
                                                  HorizontalAlignment="Center"
                                                  Margin="0,5,0,-5"
                                                  HorizontalContentAlignment="Center"
                                                  FontFamily="Source Sans Pro">
                                            </Label>
                                            <TextBox IsReadOnly="true" x:Name="TB_Spare1" Margin="5" FontWeight="DemiBold" FontSize="15" Height="35" Style="{StaticResource BorderBlackTextboxStyle}"/>
                                        </StackPanel>
                                        <StackPanel  Grid.Column="3" Orientation="Vertical">
                                            <Label  Content="---"
                                                  Name="lb_HRoto"
                                                  Foreground="Black"
                                                  FontSize="15"
                                                    FontWeight="Bold"
                                                  HorizontalAlignment="Center"
                                                  Margin="0,5,0,-5"
                                                    HorizontalContentAlignment="Center"
                                                  FontFamily="Source Sans Pro">
                                            </Label>
                                            <TextBox IsReadOnly="true"  x:Name="TB_Spare2"  Margin="5" FontWeight="DemiBold" FontSize="15" Height="35" Style="{StaticResource BorderBlackTextboxStyle}"/>

                                        </StackPanel>
                                        <Grid Grid.Column="5">
                                            <Grid Grid.Row="0">
                                                <Button Grid.Column="0" Content="Test" x:Name="Test"  Padding="5,5" Height="35"  FontSize="10"  VerticalAlignment="Center"  Click="bt_test_Click"/>
                                            </Grid>

                                        </Grid>
                                        <Grid Grid.Column="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Label Content="{DynamicResource btn_Off_Buzzer}" FontWeight="DemiBold" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                            <ToggleButton Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" Margin="0,0,0,5"
                                              IsChecked="False" x:Name="Sw_Offbuzzer"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              ToolTip="MaterialDesignSwitchLightToggleButton" Unchecked="Sw_Offbuzzer_UnChecked" Checked="Sw_Offbuzzer_Checked" />

                                        </Grid>


                                    </Grid>

                                </Grid>

                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <!-- Dòng chiếm toàn bộ không gian -->
                            </Grid.RowDefinitions>
                            <Grid x:Name="Pannel_Monitor"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch" />
                        </Grid>
                    </Grid>





                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
