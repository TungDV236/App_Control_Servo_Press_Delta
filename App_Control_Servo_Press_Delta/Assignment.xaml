<Window x:Class="App_Control_Servo_Press_Delta.Assignment"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:App_Control_Servo_Press_Delta"
        mc:Ignorable="d"
        ResizeMode="NoResize" 
        WindowStyle="None" Height="200" Width="320">
    <Grid>
        <Border BorderBrush="Black" BorderThickness="1"/>
        <StackPanel>
            <Grid PreviewMouseDown="Grid_MouseDown">
                <Border BorderBrush="Black" BorderThickness="1"/>
                <TextBox Text="BẢNG CÀI ĐẶT CA LÀM VIỆC" HorizontalContentAlignment="Center"  />
                <StackPanel Width="15"
                                    Height="15"
                                    HorizontalAlignment="Right"
                                    Margin="0,5,5,0"
                                    VerticalAlignment="Top">
                    <Image  Source="Images\Exit.png"
                                         HorizontalAlignment="Left"
                                         Stretch="Fill"
                                         PreviewMouseDown="infor_exit">
                    </Image>
                </StackPanel>
            </Grid>
            <Grid>
                <StackPanel Margin="5">

                    <TextBlock Text="Ca làm việc" />
                    <ComboBox x:Name="assignment"
               Margin="0,10,0,0" />

                    <Grid Height="25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"  Text="Thời gian bắt đầu" BorderBrush="White" />
                        <TextBox Grid.Column="1"  Text="Thời gian kết thúc" BorderBrush="White"  />
                    </Grid>
                    <Grid Height="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="25"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="25"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="hh_start" Margin="2" FontWeight="Bold" FontSize="15" Height="35" Style="{StaticResource BorderBlackTextboxStyle}"/>
                        <TextBox Grid.Column="1" Text="h" Margin="2" FontWeight="Bold" FontSize="15" Height="35" BorderBrush="White" HorizontalContentAlignment="Center" />
                        <TextBox Grid.Column="2" x:Name="mm_start" Margin="2" FontWeight="Bold" FontSize="15" Height="35" Style="{StaticResource BorderBlackTextboxStyle}"/>
                        <TextBox Grid.Column="4" x:Name="hh_stop" Margin="2" FontWeight="Bold" FontSize="15" Height="35" Style="{StaticResource BorderBlackTextboxStyle}"/>
                        <TextBox Grid.Column="5" Text="h" Margin="2" FontWeight="Bold" FontSize="15" Height="35"  BorderBrush="White" HorizontalContentAlignment="Center"/>
                        <TextBox Grid.Column="6" x:Name="mm_stop" Margin="2" FontWeight="Bold" FontSize="15" Height="35" Style="{StaticResource BorderBlackTextboxStyle}"/>


                    </Grid>
                    <Grid Height="40" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Thoát" Height="35" Width="80"   HorizontalAlignment="Left" Click="BT_exit"/>
                        <Button Grid.Column="1" Content="Lưu" Height="35" Width="80"   HorizontalAlignment="Right" Click="BT_save"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </StackPanel>



    </Grid>
</Window>

