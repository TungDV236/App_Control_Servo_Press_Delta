<UserControl x:Class="App_Control_Servo_Press_Delta.History_Error"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:App_Control_Servo_Press_Delta"
             mc:Ignorable="d"   
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch" d:DesignWidth="1530.813" >
    <Grid x:Name="Grid_size" >
        <Border BorderBrush ="Black" BorderThickness="1" Margin="-1,0,-1,0"/>
        <Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">

                    <Border BorderBrush ="Black" BorderThickness="1" Margin="-1,0,-1,0"/>
                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Label Content="{DynamicResource lb_History_Error}"      FontSize="20"     FontStyle="Normal"      FontWeight="Bold" FontFamily="Source Sans Pro"   Height="50"
                VerticalContentAlignment="Center"    HorizontalAlignment="Center"     VerticalAlignment="Center"></Label>
                        </Grid >
                        <Grid Grid.Row="1" Margin="5">
                            <DataGrid x:Name="List_Err"
                              AutoGenerateColumns="False"
                                FontSize="20"
                                Foreground="Black"
                                Background="White"
                                BorderBrush="Black"
                                BorderThickness="0.5"
                                Margin="2,2,2,4"
                                HorizontalGridLinesBrush="Black"
                                CanUserResizeColumns="False"
                                CanUserResizeRows="False"
                                IsReadOnly="True"
                                Grid.ColumnSpan="2">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="No" 
                                    Binding="{Binding STT}"
                                    Width="80" >
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Code" 
                                    Binding="{Binding Code}"
                                    Width="120" >
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Description"
                                    Binding="{Binding Content_}"
                                    Width="260" >

                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Solution"
                            Binding="{Binding Solution}"
                            Width="260">

                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Time"
                            Binding="{Binding Time}"
                            Width="Auto" >

                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </Grid>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Label Content="{DynamicResource lb_History_Operation}"      FontSize="20"     FontStyle="Normal"      FontWeight="Bold" FontFamily="Source Sans Pro"   Height="50"
                VerticalContentAlignment="Center"    HorizontalAlignment="Center"     VerticalAlignment="Center"></Label>
                    </Grid >
                    <Grid Grid.Row="1" Margin="5">
                        <DataGrid x:Name="List_History_Operation"
                              AutoGenerateColumns="False"
                                FontSize="20"
                                Foreground="Black"
                                Background="White"
                                BorderBrush="Black"
                                BorderThickness="0.5"
                                Margin="2,2,2,4"
                                HorizontalGridLinesBrush="Black"
                                CanUserResizeColumns="False"
                                CanUserResizeRows="False"
                                IsReadOnly="True"
                                Grid.ColumnSpan="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="No" 
                                    Binding="{Binding No}"
                                    Width="80" >
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="User" 
                                    Binding="{Binding User}"
                                    Width="120" >
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Log Operation"
                                    Binding="{Binding Log}"
                                    Width="400" >

                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Time"
                            Binding="{Binding Time}"
                            Width="Auto" >

                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Grid>



        </Grid>

    </Grid>
</UserControl>

