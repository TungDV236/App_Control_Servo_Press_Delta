<UserControl x:Class="App_Control_Servo_Press_Delta.Auto_Step"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:App_Control_Servo_Press_Delta"
             mc:Ignorable="d" 
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Grid>
        <Grid Grid.Row="1" Margin="20,10,20,10" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="30" MaxHeight="60"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="*" MinHeight="30" MaxHeight="60"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="*" MinHeight="30" MaxHeight="60"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="*" MinHeight="30" MaxHeight="60"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="*" MinHeight="30" MaxHeight="60"/>
            </Grid.RowDefinitions>
            <Button  Grid.Row="0"   Content="Chuẩn bị" x:Name="bt_Step0"   FontWeight="Bold"    FontSize="15"       Height="Auto"    HorizontalAlignment="Stretch"/>
            <Button  Grid.Row="2"   Content="Bắt đầu"  x:Name="bt_Step1"      FontWeight="Bold"    FontSize="15"    Height="Auto"  HorizontalAlignment="Stretch"/>
            <Button  Grid.Row="4"   Content="Ép vòng bi"  x:Name="bt_Step2"     FontWeight="Bold"    FontSize="15"  Height="Auto"  HorizontalAlignment="Stretch"/>
            <Button  Grid.Row="6"   Content="Nâng trục"  x:Name="bt_Step3"    FontWeight="Bold"    FontSize="15"    Height="Auto"  HorizontalAlignment="Stretch"/>
            <Button  Grid.Row="8"   Content="Kết thúc"  x:Name="bt_Step4"      FontWeight="Bold"   FontSize="15"   Height="Auto" HorizontalAlignment="Stretch"/>
        </Grid>
    </Grid>
</UserControl>
